{
  "name": "codevideo-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, AI-powered, code-driven video creation studio",
  "license": "MIT",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --concurrency=16",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:render-smoke": "pnpm build && node scripts/render-smoke.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "turbo": "^2.11.13",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  }
}
