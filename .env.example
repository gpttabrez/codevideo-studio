# Common server-side secrets. Generate unique random values; never commit them.
CODEVIDEO_PROXY_SECRET=replace-with-a-long-random-value
CODEVIDEO_WORKER_TOKEN=replace-with-a-different-long-random-value

# Single-user self-hosted login. For multiple users use comma-separated user:password entries.
CODEVIDEO_USERS=local:change-me
# Alternative: pre-hashed htpasswd lines in CODEVIDEO_HTPASSWD (takes precedence over CODEVIDEO_USERS).

# API listens on the internal Docker network only; the browser uses the web proxy.
PORT=3001
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:8080
API_MAX_BODY_BYTES=1000000
NODE_ENV=production

# Web client. Keep VITE_API_URL empty so fetch uses the authenticated same-origin proxy.
VITE_API_URL=
WEB_PORT=8080
# Local Vite development proxy only; it injects identity server-side and must not be exposed publicly.
API_PROXY_TARGET=http://localhost:3001
CODEVIDEO_DEV_USER=local

# Render queue and worker
RENDER_DATA_DIR=./data
RENDER_OUTPUTS_DIR=./data/outputs
WEB_URL=http://localhost:5173
WORKER_API_URL=http://localhost:3001
RENDER_MAX_EXECUTION_MS=300000
RENDER_CANCEL_POLL_MS=1000

# Server-side render limits
RENDER_MAX_WIDTH=1920
RENDER_MAX_HEIGHT=1080
RENDER_MAX_PIXELS=2073600
RENDER_MAX_FPS=30
RENDER_MAX_SCENES=20
RENDER_MAX_FRAMES=18000
RENDER_MAX_SCENE_DURATION_SECONDS=60
RENDER_MAX_ELEMENTS_PER_SCENE=200
RENDER_MAX_ASSET_BYTES=25000000
RENDER_MAX_SOURCE_BYTES=200000
RENDER_MAX_CONCURRENT_PER_OWNER=2
RENDER_MAX_QUEUED_PER_OWNER=5
RENDER_MAX_QUEUED_GLOBAL=50

# Chromium sandbox is enabled by default. Set this only on platforms where the sandbox cannot run.
# CHROMIUM_DISABLE_SANDBOX=true

# Optional AI providers - keep keys server-side only
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
