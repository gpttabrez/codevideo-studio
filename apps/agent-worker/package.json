{
  "name": "@codevideo/agent-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup src/index.ts --format esm --platform node --target node22 --out-dir dist --clean",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@codevideo/agent-jobs": "workspace:*",
    "@codevideo/ai-gateway": "workspace:*",
    "@codevideo/model-config": "workspace:*",
    "@codevideo/project-schema": "workspace:*",
    "@codevideo/tool-runtime": "workspace:*",
    "@codevideo/vision-loop": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  }
}
